    "@iconify/tools": "2.2.6",
    "@lhci/cli": "0.14.0",
    "@mdi/js": "5.9.55",
    "@nuxt/icon": "1.7.5",
    "@nuxt/image": "1.8.1",
    "@nuxt/test-utils": "3.14.4",
    "@nuxt/types": "2.15.8",
    "@nuxtjs/eslint-config-typescript": "12.0.0",
    "@nuxtjs/eslint-module": "4.1.0",
    "@nuxtjs/i18n": "8.5.6",
